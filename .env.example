# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default for local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./fraudgraph.db

# AI Provider Configuration
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-pro

# Risk Fusion Configuration
WEIGHT_ML=0.45
WEIGHT_GRAPH=0.35
WEIGHT_BEHAVIOR=0.20
